{
  "name": "@thai-translate/client",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@babel/runtime": "^7.28.4",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@thai-translate/contracts": "workspace:*",
    "expo": "~57.0.8",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.7",
    "expo-font": "~57.0.1",
    "expo-linking": "~57.0.4",
    "expo-router": "~57.0.8",
    "expo-speech": "~57.0.1",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.0",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.1",
    "rimraf": "^6.1.3",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "dev": "EXPO_PUBLIC_API_BASE_URL=http://localhost:3000 expo start --web",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web",
    "build:android": "NODE_ENV=production expo prebuild --platform android && cd android && NODE_ENV=production ./gradlew --no-daemon --max-workers=4 assembleRelease -PreactNativeArchitectures=arm64-v8a",
    "build:android:universal": "NODE_ENV=production expo prebuild --platform android && cd android && NODE_ENV=production ./gradlew --no-daemon --max-workers=4 assembleRelease",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand --coverage",
    "clean": "rimraf dist coverage .expo"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/app/_layout.tsx",
      "!src/app/index.tsx",
      "!src/**/*.d.ts",
      "!src/**/*.web.ts",
      "!src/features/translator/translator-screen.tsx"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 70,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  },
  "private": true
}
